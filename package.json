{
  "name": "openhack",
  "version": "0.1.0",
  "description": "OpenHack — an operator-grade AI security research workspace",
  "author": "OpenHack",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --grep-invert \"packaged\"",
    "test:packaged": "playwright test e2e/packaged.spec.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write src tests e2e *.ts *.json *.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "24.12.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "45.4.1",
    "electron-builder": "26.15.7",
    "electron-vite": "6.0.0",
    "playwright": "1.60.0",
    "png-to-ico": "^3.0.0",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "typescript": "6.0.2",
    "vite": "8.2.4",
    "vitest": "^5.1.1"
  }
}
